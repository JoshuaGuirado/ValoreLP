# Copie para .env e preencha. Todas são opcionais.

# WhatsApp dos botões (somente dígitos, com 55 + DDD)
VITE_WHATSAPP=554498441083

# URL do app da Web do Google Apps Script (ver integrations/google-apps-script/README.md)
VITE_LEAD_ENDPOINT=

# Link público do PDF do guia (ex.: /guia-reforma-tributaria-valore.pdf ou link do Google Drive)
